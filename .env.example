# Copy to .env and adjust. .env is gitignored; never commit it.
# The proxy never needs a private key.

# JSON-RPC endpoint the proxy forwards to (local anvil by default).
UPSTREAM_RPC_URL=http://127.0.0.1:8545

# Where the proxy listens. Point your agent's RPC URL here.
PROXY_HOST=127.0.0.1
PROXY_PORT=8546

LOG_LEVEL=INFO

# Audit log: one JSON line per intercepted transaction, created with mode 0600.
# It contains signed transactions (including blocked ones), so keep it private.
AUDIT_LOG_PATH=logs/audit.jsonl

# Allow legacy transactions without an EIP-155 chain id (replayable across chains).
# Keep false unless you know exactly why you need it.
ALLOW_LEGACY_UNPROTECTED=false

# Simulation (M2): every transaction is first run on a private anvil fork of the
# upstream. Install Foundry (https://getfoundry.sh); anvil can be a name on PATH or a path.
ANVIL_PATH=anvil
# Transactions that can't be simulated within this many seconds are blocked.
SIMULATION_TIMEOUT_SECONDS=10
# Each token transfer or approval in a transaction is checked against the
# token's storage (two reads per check). Transactions that need more checks
# than this are blocked.
MAX_TOKEN_STATE_CHECKS=50
# anvil's chain mode for the simulation fork: auto, ethereum or optimism.
# auto picks optimism for Base (8453, 84532) and OP Mainnet (10, 11155420);
# set optimism explicitly for other OP-stack chains.
SIMULATOR_NETWORK=auto

# Mandate capture with an LLM (M3, optional). Only the capture CLI reads these;
# the proxy never does. Without a key, use the structured path (no LLM).
# The instruction text, including amounts and addresses, is sent to this API.
# Never pass the key as a command-line flag.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_SECONDS=120

# Mandates (M3). `mandate-firewall mandate new` creates the store (0600 in a
# 0700 directory). The proxy reads MANDATE_DB_PATH too, refuses to start
# without it, and blocks every transaction whose sender has no active mandate.
MANDATE_DB_PATH=state/mandates.db
# The agent accounts mandates may be created for, comma-separated, each with
# its exact EIP-55 checksum. Example: anvil's dev account 0 (public, local only).
MANDATE_PRINCIPALS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
MANDATE_CHAIN_ID=84532
MANDATE_LIFETIME_MINUTES=30
MANDATE_MAX_TRANSACTIONS=3
# Optional: a directory with your own <chain_id>.json token/venue registry.
# Read by capture and by the proxy, which names tokens and venues with it in
# explanations and refuses to start without a valid one for the upstream chain.
# Unset: the shipped registry (Base Sepolia only).
# REGISTRY_PATH=
# Optional: a JSON object {"Bob": "0x<checksummed address>"} for recipients you
# pay often. Refused if other users can write it.
# ADDRESS_BOOK_PATH=
